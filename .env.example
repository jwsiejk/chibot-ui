# Non-secrets (safe defaults for local)
ADMIN_EMAILS=jwsiejk@purestorage.com
ADVANCED_LOGGING_ENABLED=True
APP_ENV=production
ASKCHIP_AUTO_ARM_MS=250
ASR_FINAL_GRACE_S=1.0
ASR_POST_FLUSH_WAIT_S=1.0
ASR_READY_WAIT_S=1.5
CHIBOT_DISABLE_RAW_FALLBACK=1
CSRF_ENFORCED=true
DATABASE_URL=postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DD_TRACE_ENABLED=0
DEEPGRAM_LISTEN_URL=wss://api.deepgram.com/v1/listen
DEEPGRAM_UTTERANCE_END_MS=3000
DG_ENABLE_PARTIALS=true
DG_FINAL_WAIT_S=20
DG_LINGER_MS=8000
DG_OPEN_MICRO_WAIT_S=.60
ELEVEN_INACTIVITY=180
ELEVEN_MODEL_ID=eleven_flash_v2_5
ELEVEN_OUTPUT_FORMAT=pcm_24000
ELEVEN_OUTPUT_FORMAT_WS=pcm_24000
EMAIL_FROM_NAME=Chip
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=you@example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_WEBHOOK_SECRET=<set-if-used>
EMAIL_WEBHOOK_URL=<set-if-used>
ENABLE_ADMIN_SSE=true
ENABLE_NLU_LOGGING=1
FEATURE_ADMIN_UI=1
FEATURE_AUDIO=1
FEATURE_TOOLS=1
FROM_EMAIL=you@example.com
GUNICORN_GRACEFUL_TIMEOUT=45
GUNICORN_KEEP_ALIVE=75
GUNICORN_TIMEOUT=90
LLM_VENDOR=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=12
LLM_RETRIES=1
MIC_CAPTURE=1
MIC_ECHO_WS=1
PIP_ONLY_BINARY=numpy,pandas,PyMuPDF
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
SESSION_TYPE=filesystem
SUGGESTION_MAX=3
WEB_CONCURRENCY=1
WS_BEARER_ONLY=1
WS_FAIL_LIMIT=10
WS_FAIL_WINDOW_SEC=60
WS_FINAL_GUARD_MS=900
WS_NO_AUDIO_DETECT_WINDOW_S=10
WS_NO_AUDIO_NUDGE_ONLY=1
WS_TOKEN_REQUIRED=1
stt_mode=streaming

# Render UI secrets (leave blank locally; set in Render dashboard)
ADMIN_SSE_E2E_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EMAIL_HOST_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=
SECRET_KEY=
