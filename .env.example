OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=96
OLLAMA_TEMPERATURE=0.4
OLLAMA_TOP_P=0.9
KOKORO_TTS_BASE_URL=http://127.0.0.1:8880
KOKORO_TTS_VOICE=af_sarah
KOKORO_TTS_FORMAT=wav
KOKORO_TTS_TIMEOUT_MS=30000
FASTER_WHISPER_BASE_URL=http://127.0.0.1:8890
FASTER_WHISPER_MODEL=base.en
FASTER_WHISPER_LANGUAGE=en
FASTER_WHISPER_TIMEOUT_MS=20000

# Optional Windows local runtime startup script settings (machine-local only)
LOCAL_RUNTIME_PYTHON=.\.venv-local-runtime\Scripts\python.exe
LOCAL_RUNTIME_VENV=.venv-local-runtime
KOKORO_TTS_ASSET_DIR=C:\AskChipAssets\kokoro
KOKORO_TTS_RUN_COMMAND=.\.venv-local-runtime\Scripts\python.exe services\local-runtime\kokoro_tts_server.py --host 127.0.0.1 --port 8880 --model C:\AskChipAssets\kokoro\kokoro-v1.0.onnx --voices C:\AskChipAssets\kokoro\voices-v1.0.bin --provider cuda
FASTER_WHISPER_RUN_COMMAND=.\.venv-local-runtime\Scripts\python.exe services\local-runtime\faster_whisper_stt_server.py --host 127.0.0.1 --port 8890 --model base.en --device cuda --compute-type int8_float16 --language en
