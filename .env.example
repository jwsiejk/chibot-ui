# Flask secret
SECRET_KEY=change-me

# Database (Neon/Postgres) — must include sslmode=require for Neon
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# OpenAI (optional)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs (optional)
ELEVEN_API_KEY=eleven-...
ELEVEN_VOICE_ID=YOUR_VOICE_ID
ELEVEN_MODEL_ID=eleven_multilingual_v2

# Email SMTP (optional)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=bot@company.com
SMTP_PASS=***
EMAIL_FROM=Ask Chip <bot@company.com>
# Comma-separated allowlist. If omitted, mail is restricted to the sender's domain.
EMAIL_ALLOWLIST=user@company.com

# Americas accounts CSV
ACCOUNTS_CSV_PATH=static/data/americas_accounts.csv
