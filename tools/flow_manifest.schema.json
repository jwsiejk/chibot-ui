{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chibot-ui/tools/flow_manifest.schema.json",
  "title": "Flow handoff package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exported_at",
    "session_id",
    "levels",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "event_count": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha1"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^\\0]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha1": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "sha1_first8": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "content_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
