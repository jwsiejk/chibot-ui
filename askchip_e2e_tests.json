{
  "meta": {
    "version": "1.0",
    "notes": "Foundations-first probes to catch greet dupes, stuck mic, ASR gating, timeouts, state spam, chips governance, persona governor, session goals, NLU completeness."
  },
  "config": {
    "clarify_threshold": 0.55,
    "accept_threshold": 0.70,
    "chips_max": 3,
    "chips_word_max": 7,
    "persona_intensity": 0.13,
    "nlu_llm_enabled": true,
    "nlu_pack_similarity_threshold": 0.55,
    "nlu_llm_timeout_s": 6.0,
    "asr_ready_wait_s": 0.3
  },
  "endpoints": {
    "ui_base_url": "https://YOUR_DOMAIN/",
    "admin_sse_url": "https://YOUR_DOMAIN/api/v1/admin/logs",
    "ws_url": "wss://YOUR_DOMAIN/ws/v1/chat"
  },
  "probes": [
    {
      "id": "P1_greet_dupe_guard",
      "user_action": "Press Start; do not speak for 3s.",
      "inputs": [],
      "expect_signals": [
        {"stream": "admin", "must_include": ["assistant_chunk", "assistant_end", "assistant_audio", "UtteranceEnd"], "max_count_per_turn": {"assistant_end": 1}},
        {"stream": "browser_console", "must_not_include": ["Duplicate assistant final", "double greet"] }
      ],
      "fail_if": [
        {"admin_count_gt": {"assistant_end": 1}},
        {"admin_any": ["Timed out waiting for ASR final"]}
      ],
      "recommendations_on_fail": ["R_DEDUP_FINALS", "R_CANCEL_TIMEOUT_ON_FINAL"]
    },
    {
      "id": "P2_mic_arms_after_greet",
      "user_action": "Begin speaking within 1s of Chip’s greet audio.",
      "inputs": ["sample_utterance_short.wav"],
      "expect_signals": [
        {"stream": "browser_console", "must_include": ["mic_start", "streamed audio chunk"]},
        {"stream": "admin", "must_include": ["asr:start"], "latency_lt_ms": {"first_partial_from_mic_start": 1200}}
      ],
      "fail_if": [
        {"admin_missing": ["asr:start"]},
        {"latency_gte_ms": {"first_partial_from_mic_start": 2000}}
      ],
      "recommendations_on_fail": ["R_ARM_MIC_IMMEDIATELY", "R_LOWER_READY_WAIT_OR_TRICKLE"]
    },
    {
      "id": "P3_asr_ready_gate",
      "user_action": "Speak one normal sentence.",
      "inputs": ["sample_sentence.wav"],
      "expect_signals": [
        {"stream": "admin", "must_include": ["latency_breakdown"], "latency_lt_ms": {"dg_connect": 600, "first_partial_from_mic_start": 1200}}
      ],
      "fail_if": [
        {"latency_gte_ms": {"first_partial_from_mic_start": 2000}}
      ],
      "recommendations_on_fail": ["R_READY_OR_300MS", "R_LOWER_READY_WAIT"]
    },
    {
      "id": "P4_containerized_opus_sanitized",
      "user_action": "Speak and capture Deepgram WS request.",
      "inputs": [],
      "expect_signals": [
        {"stream": "network", "must_not_include_query_params": ["encoding", "sample_rate", "channels"]},
        {"stream": "admin", "must_include": ["container=webm/opus", "containerized=true"]}
      ],
      "fail_if": [
        {"network_has_any_params": ["encoding", "sample_rate", "channels"]},
        {"admin_missing": ["containerized=true"]}
      ],
      "recommendations_on_fail": ["R_SANITIZE_DG_URL_FOR_CONTAINERIZED"]
    },
    {
      "id": "P5_close_timeout_race",
      "user_action": "Finish speaking; remain silent.",
      "inputs": ["sample_sentence.wav"],
      "expect_signals": [
        {"stream": "admin", "must_include": ["Results final", "asr:final", "CloseStream ack"], "must_not_include": ["Timed out waiting for ASR final"]}
      ],
      "fail_if": [
        {"admin_any": ["Timed out waiting for ASR final"]}
      ],
      "recommendations_on_fail": ["R_CANCEL_TIMEOUT_ON_FINAL"]
    },
    {
      "id": "P6_barge_in_pauses_tts",
      "user_action": "Start talking while Chip is speaking.",
      "inputs": ["interrupt.wav"],
      "expect_signals": [
        {"stream": "admin", "must_include": ["barge_in", "tts_pause"], "latency_lt_ms": {"tts_pause_after_vad": 250}}
      ],
      "fail_if": [
        {"latency_gte_ms": {"tts_pause_after_vad": 300}}
      ],
      "recommendations_on_fail": ["R_BARGEIN_PAUSE_ON_VAD", "R_ECHO_THRESHOLD_BOOST"]
    },
    {
      "id": "P7_state_debounce",
      "user_action": "Two short back-to-back turns.",
      "inputs": ["short1.wav", "short2.wav"],
      "expect_signals": [
        {"stream": "admin", "must_not_spam_state": {"window_ms": 500}}
      ],
      "fail_if": [
        {"admin_any": ["state: ready", "state: ready", "state: ready"]}
      ],
      "recommendations_on_fail": ["R_DEBOUNCE_STATE_500MS"]
    },
    {
      "id": "P8_no_assistant_dup_messages",
      "user_action": "One short question expecting text reply.",
      "inputs": ["short_q.wav"],
      "expect_signals": [
        {"stream": "admin", "max_count_per_turn": {"assistant_end": 1}}
      ],
      "fail_if": [{"admin_count_gt": {"assistant_end": 1}}],
      "recommendations_on_fail": ["R_DEDUP_FINALS", "R_SINGLE_POLICY_COMMIT"]
    },
    {
      "id": "P9_chips_only_when_needed",
      "user_action": "Say: 'Help me set up Portworx.'",
      "inputs": ["underspecified.wav"],
      "expect_signals": [
        {"stream": "admin", "must_include": ["nlu"], "nlu_flags": {"needs_clarification": true, "missing_any_of": ["depth", "delivery_pref"]}},
        {"stream": "admin", "must_include": ["suggestions_made"], "chips_lte": 3}
      ],
      "fail_if": [
        {"chips_gt": 3},
        {"nlu_flags": {"needs_clarification": false}}
      ],
      "recommendations_on_fail": ["R_SYNTHESIZE_CHIPS_FROM_MISSING", "R_CAP_CHIPS"]
    },
    {
      "id": "P10_persona_governor_on_diagnose",
      "user_action": "Say: 'After 3.x upgrade, PX cluster degraded; volumes won’t mount.'",
      "inputs": ["diagnose.wav"],
      "expect_signals": [
        {"stream": "admin", "must_include": ["policy_decision: diagnose"], "must_not_include": ["persona_applied"]}
      ],
      "fail_if": [{"admin_any": ["persona_applied"]}],
      "recommendations_on_fail": ["R_SKIP_PERSONA_ON_DIAGNOSE"]
    },
    {
      "id": "P11_session_goal_persists",
      "user_action": "Choose [Deep dive] when asked, then ask again for steps.",
      "inputs": [],
      "expect_signals": [
        {"stream": "admin", "must_include": ["session_goal"], "goal_fields": {"depth": "deep_dive", "confirmed_contains": ["depth"]}},
        {"stream": "admin", "must_not_include": ["re-ask depth"]}
      ],
      "fail_if": [{"goal_missing": ["depth"]}],
      "recommendations_on_fail": ["R_SESSION_GOAL_MERGE_AND_CONFIRM"]
    },
    {
      "id": "P12_nlu_completeness",
      "user_action": "Say: 'Install FlashArray for VMware and email me the steps.'",
      "inputs": ["fa_vmware_email.wav"],
      "expect_signals": [
        {"stream": "admin", "must_include": ["nlu"], "nlu_must_have_keys": ["user_goal","phase","depth","delivery_pref","intent_hint","entities","confidence","needs_clarification"]}
      ],
      "fail_if": [{"nlu_missing_any": ["delivery_pref","entities.product","entities.env"]}],
      "recommendations_on_fail": ["R_EXTEND_INTERPRETER_FIELDS"]
    }
  ],
  "recommendations_catalog": {
    "R_DEDUP_FINALS": "Add per-turn assistant_final guard by turn_id in WS bus; ignore duplicate policy commits.",
    "R_CANCEL_TIMEOUT_ON_FINAL": "Cancel 'wait for final' watchdog on either asr:final or CloseStream ack.",
    "R_ARM_MIC_IMMEDIATELY": "Ensure recorder arms immediately after greet; verify mediaRecorder.ondataavailable fires; send raw binary frames.",
    "R_LOWER_READY_WAIT_OR_TRICKLE": "Set ASR_READY_WAIT_S to 0.2–0.3 or implement 'ready OR 300ms' trickle of buffered chunks.",
    "R_READY_OR_300MS": "Gate flush on 'DG ready OR 300ms', whichever first; then stream.",
    "R_SANITIZE_DG_URL_FOR_CONTAINERIZED": "For WebM/Opus, omit encoding/sample_rate/channels in Deepgram URL.",
    "R_BARGEIN_PAUSE_ON_VAD": "Pause TTS on first VAD hit; confirm ~420ms; resume/commit accordingly.",
    "R_ECHO_THRESHOLD_BOOST": "Increase echo-aware VAD threshold during TTS to avoid false triggers.",
    "R_DEBOUNCE_STATE_500MS": "Debounce identical state emissions for 500ms to prevent spam.",
    "R_SINGLE_POLICY_COMMIT": "Ensure one policy decision per asr:final; bus should not trigger a second commit.",
    "R_SYNTHESIZE_CHIPS_FROM_MISSING": "Generate chips strictly from nlu.missing (depth/delivery/phase).",
    "R_CAP_CHIPS": "Respect chips_max and chips_word_max from DB config.",
    "R_SKIP_PERSONA_ON_DIAGNOSE": "Persona composer should skip on strategy=diagnose or urgency=high.",
    "R_SESSION_GOAL_MERGE_AND_CONFIRM": "Merge NLU into session_goal; mark confirmed on user choice; do not re-ask.",
    "R_EXTEND_INTERPRETER_FIELDS": "Interpreter must always populate phase, delivery_pref, user_goal, entities; set needs_clarification when unknown."
  }
}
