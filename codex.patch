+
+    def on_tts_end(
+        self, sid: str, utt_id: str, post_hold_ms: int | None = None
+    ) -> None:
+        """Release the TTS mask and optionally engage a post-hold."""
+
+        self._gate.set_reason(
+            "tts_active",
+            False,
+            sid=sid,
+            meta={"tts": {"utt_id": utt_id}},
