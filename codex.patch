+def _coerce_float(value: Any) -> Optional[float]:
+    if value is None:
+        return None
+    if isinstance(value, (int, float)):
+        return float(value)
+    if isinstance(value, str):
+        stripped = value.strip()
+        if not stripped:
+            return None
+        try:
+            return float(stripped)
+        except Exception:
+            return None
+    try:
+        return float(value)  # type: ignore[arg-type]
+    except Exception:
+        return None
+
