+  assert.equal(started, true, 'recorder should start after greet gate release');
+  await hooks.state.chunkSendPromise;
+
+  const audioStartEvents = transportEvents.filter((ev) => ev.kind === 'json' && ev.payload?.type === 'AudioStart');
