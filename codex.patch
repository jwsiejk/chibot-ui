 /* Theme */
 :root{
   --bg:#0f1115; --panel:#161a22; --text:#e6e9ef; --muted:#9aa4b2;
   --link:#7aa0ff; --accent:#ff8a00; --border:#202533;
 }
 
 *{box-sizing:border-box}
 
 body{
   margin:0; background:var(--bg); color:var(--text);
   font:14px/1.55 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
 }
 
 a{color:var(--link); text-decoration:none}
 a:hover{text-decoration:underline}
 
 h1{font-size:28px; margin:0 0 12px}
 h2,h3{margin:18px 0 8px}
 .muted{color:var(--muted)}
 .hidden{display:none !important}
 
 /* ---------------- Container spacing even without wrapper classes ---------------- */
 main,#main,#app,#app-root,.app{max-width:1080px; margin:24px auto; padding:0 16px}
 
 /* ---------------- Top bar / header ---------------- */
-.topbar{display:flex;justify-content:flex-start;align-items:center;padding:14px 32px;background:#0c0e13;border-bottom:1px solid var(--border);box-shadow:0 8px 24px rgba(5,8,12,.35)}
+.topbar{display:flex;justify-content:flex-end;align-items:center;padding:14px 32px;background:#0c0e13;border-bottom:1px solid var(--border);box-shadow:0 8px 24px rgba(5,8,12,.35)}
+.topbar-inner{display:flex;justify-content:flex-end;align-items:center;flex:1 1 auto;width:100%;min-width:0;gap:16px}
 .dropdown{position:relative;display:inline-flex}
 .askchip-menu{z-index:30}
 .askchip-trigger{
-  display:flex;align-items:center;gap:10px;
-  font-weight:700;font-size:20px;letter-spacing:.3px;
+  display:flex;align-items:center;gap:12px;
+  font-weight:700;font-size:16px;letter-spacing:.3px;
   color:var(--accent);
   background:rgba(255,138,0,.08);
   border:1px solid rgba(255,138,0,.35);
   border-radius:999px;
-  padding:8px 16px;
+  padding:10px 20px;
   cursor:pointer;
   box-shadow:0 10px 24px rgba(255,138,0,.12);
   transition:transform .2s ease, box-shadow .2s ease, background .2s ease;
 }
 .askchip-trigger:hover{transform:translateY(-1px);box-shadow:0 16px 36px rgba(255,138,0,.22);background:rgba(255,138,0,.16)}
 .askchip-trigger:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
-.askchip-logo{width:28px;height:28px;border-radius:50%;box-shadow:0 0 18px rgba(255,138,0,.45)}
+.askchip-logo{width:34px;height:34px;border-radius:50%;box-shadow:0 0 18px rgba(255,138,0,.45)}
 .askchip-text{font-weight:700}
 .askchip-caret{font-size:16px;color:var(--text);margin-left:4px}
 .dropdown-content{
   position:absolute;
   top:calc(100% + 10px);
   right:0;
   min-width:180px;
   padding:8px 0;
   background:var(--panel);
   border:1px solid var(--border);
   border-radius:14px;
   box-shadow:0 20px 48px rgba(8,10,14,.55);
   z-index:60;
 }
 .dropdown-content a{
   display:block;
   padding:10px 18px;
   font-size:14px;
   color:var(--text);
 }
 .dropdown-content a:hover{background:rgba(122,160,255,.12)}
 
 /* ---------------- Zoom-inspired meeting layout ---------------- */
 main.meeting-layout{
   max-width:1180px;
