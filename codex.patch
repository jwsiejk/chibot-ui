     def _drop_buffer_before(self, ctx: AdapterContext, threshold: int) -> None:
         removed = False
         for key in list(ctx.audio_buffer):
             if key < threshold:
                 ctx.audio_buffer.pop(key, None)
                 removed = True
         if removed:
             if ctx.audio_buffer:
                 ctx.audio_highest_seq = max(ctx.audio_buffer)
