+import types
+
+import pytest
+
+from app.obs import nlu_logging
+
+
+class _DummySettings:
+    def __init__(self, enabled: bool) -> None:
+        self.enable_nlu_logging = enabled
+
+
+class _FakeTime:
+    def __init__(self) -> None:
+        self._ticks = 0
+
+    def monotonic(self) -> float:
+        self._ticks += 1
+        return 100.0 + self._ticks * 0.1
+
+
+@pytest.fixture
+def fake_time(monkeypatch):
+    fake = _FakeTime()
+    monkeypatch.setattr(nlu_logging.time, "monotonic", fake.monotonic)
+    return fake
+
+
+def test_nlu_logging_emits_when_enabled(monkeypatch, fake_time):
+    events = []
+
+    def capture(kind: str, **fields):
+        events.append((kind, fields))
+
+    monkeypatch.setattr(nlu_logging, "_jlog", capture)
+
+    ctx = nlu_logging.create_context(
+        turn_id="turn-1",
+        session_id="session-1",
+        correlation_user_msg_id="corr-1",
+        meta={"source": "user_ws", "channel": "ws"},
+        settings=_DummySettings(True),
+        cfg={"nlu_logging_enabled": True},
+    )
+
+    ctx.log_start("hello world")
+    ctx.log_intent({"intent": "ask", "confidence": 0.9, "alternates": [{"intent": "alt", "confidence": 0.5}]})
+    ctx.log_entities({"email": "user@example.com"})
+    ctx.log_llm_response(
+        output_tokens=42,
+        finish_reason="stop",
+        preview="hello world preview",
+        fallback_fired=False,
+        fallback_reason=None,
+    )
+    ctx.mark_fallback(False, None)
+    ctx.log_done()
+
+    kinds = [kind for kind, _ in events]
+    assert "nlu.start" in kinds
+    assert "nlu.intent" in kinds
+    assert "nlu.entities" in kinds
+    assert "llm.response" in kinds
+    assert "nlu.done" in kinds
+
+    entity_event = next(fields for kind, fields in events if kind == "nlu.entities")
+    assert entity_event["entities"]["email"] == "[redacted-email]"
+
+    done_event = next(fields for kind, fields in events if kind == "nlu.done")
+    assert done_event["latency_ms"] >= 0
+
+
+def test_nlu_logging_suppressed_when_disabled(monkeypatch, fake_time):
+    events = []
+
+    def capture(kind: str, **fields):
+        events.append((kind, fields))
+
+    monkeypatch.setattr(nlu_logging, "_jlog", capture)
+
+    ctx = nlu_logging.create_context(
+        turn_id="turn-2",
+        session_id="session-2",
+        meta={"source": "user_http", "channel": "http"},
+        settings=_DummySettings(False),
+        cfg={"nlu_logging_enabled": True},
+    )
+
+    ctx.log_start("test")
+    ctx.log_intent({"intent": "ask", "confidence": 0.2})
+    ctx.log_done()
+
+    assert events == []
