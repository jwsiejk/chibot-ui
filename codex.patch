+    try:
+        streaming.run_ws_user_turn(sid, "hello")
+        frames = []
+        while True:
+            try:
+                frames.append(q.get(timeout=0.2))
+            except Empty:
+                break
+    finally:
+        bus.unsubscribe(sid, q)
+        bus.note_assistant_turn(sid, None)
+        bus._canceled.discard((sid, prepared_turn_id))
