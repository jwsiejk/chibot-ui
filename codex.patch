 async def get_user(email: str) -> Optional[Dict[str, Any]]:
     pool = await get_pool()
     async with pool.acquire() as conn:
         row = await conn.fetchrow(
             "SELECT email, name, title, region FROM users WHERE email=$1",
             email,
         )
     if row is None:
         return None
     return {
         "email": row["email"],
         "name": row["name"],
         "title": row["title"],
         "region": row["region"],
     }
 
 
