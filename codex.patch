+"""Helpers for normalising EVT_SESSION_STEP telemetry events."""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any, Dict
+
+SESSION_STEP = "EVT_SESSION_STEP"
+_VALID_OUTCOMES = {"ok", "warn", "error"}
+
+_logger = logging.getLogger(__name__)
+
+
+def now_ms() -> int:
+    """Return the current wall-clock time in milliseconds."""
+
+    return int(time.time() * 1000)
+
+
+def coerce_session_step(event: Dict[str, Any]) -> Dict[str, Any]:
+    """Return a canonicalised session-step payload."""
+
+    outcome = event.get("outcome", "ok")
+    if outcome not in _VALID_OUTCOMES:
+        outcome = "ok"
+
+    coerced: Dict[str, Any] = {
+        "type": SESSION_STEP,
+        "sid": event.get("sid", "unknown"),
+        "sock": event.get("sock", ""),
+        "proto": event.get("proto", ""),
+        "seq": int(event.get("seq", 0) or 0),
+        "phase": event.get("phase", ""),
+        "step": event.get("step", ""),
+        "outcome": outcome,
+        "reason_code": event.get("reason_code", ""),
+        "ts_ms": int(event.get("ts_ms", now_ms())),
+        "mono_ms": float(event.get("mono_ms", 0.0) or 0.0),
+        "meta": event.get("meta", {}) or {},
+    }
+    return coerced
+
+
+def level_for_outcome(outcome: str) -> str:
+    """Map a session-step outcome to a logging severity."""
+
+    return {"ok": "INFO", "warn": "WARNING", "error": "ERROR"}.get(outcome, "INFO")
+
+
+def emit_session_step(telemetry_bus: Any, event: Dict[str, Any]) -> None:
+    """Normalise, publish, and log a session-step event."""
+
+    payload = coerce_session_step(event)
+    level_name = level_for_outcome(payload["outcome"])
+    payload["level"] = level_name.lower()
+    telemetry_bus.publish(payload)
+    _logger.log(getattr(logging, level_name, logging.INFO), "evt=session_step %s", payload)
