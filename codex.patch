+      }
+      turnMap.set(turnId, turn);
+    }
+  }
+
+  const assistantFrames = Array.from(turnMap.values()).map(turn => ({
+    turn_id: turn.turn_id,
+    text: turn.chunks.join(' ').trim(),
+    chunk_count: turn.chunks.length,
+    assistant_end_count: turn.assistant_end_count,
