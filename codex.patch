     def _handle_final(self, state: _StreamState, payload: Mapping[str, Any]) -> None:
         text = _extract_text(payload)
         if not text:
             return
         state.final_count += 1
         ts_ms = _now_ms()
         metadata = {"ts": ts_ms}
