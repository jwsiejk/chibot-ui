 def _coerce_event(payload: Mapping[str, Any]) -> HistoryItem:
     data: HistoryItem = dict(payload)
 
     event_name = data.get("event") or data.get("kind") or data.get("label")
     if not isinstance(event_name, str) or not event_name.strip():
