+    const params = getQueryParams();
+    if (forceRefresh) {
+      params.set('refresh', '1');
+    }
+    const url = `/api/v1/policy/effective?${params.toString()}`;
+    const resp = await fetch(url, {
+      method: 'GET',
+      credentials: 'include',
