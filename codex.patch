+
+def _clip_preview(val: object, *, limit: int = 120) -> object:
+    if not isinstance(val, str):
+        return val
+    if len(val) <= limit:
+        return val
+    if limit <= 1:
+        return val[:limit]
+    return val[: limit - 1] + "…"
+
+
+def _normalize_sid(value: object) -> str | None:
+    if value is None:
+        return None
+    try:
+        txt = str(value)
+    except Exception:
+        return None
+    txt = txt.strip()
+    return txt or None
+
+
+def _normalize_turn_id(value: object) -> str | None:
+    if value is None:
+        return None
+    try:
