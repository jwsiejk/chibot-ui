+def test_ws_emits_nlu_admin_event_before_llm(monkeypatch):
+    monkeypatch.setenv("WS_TOKEN_REQUIRED", "0")
+    monkeypatch.setenv("DEEPGRAM_API_KEY", "test-key")
+
+    admin_events = []
