     def _handle_recognition_started(
         self, state: _StreamState, payload: Mapping[str, Any]
     ) -> None:
+        self._logger.info(
+            "evt=sm_recognition_started sid=%s stream_id=%s",
+            state.sid,
+            state.stream_id,
+        )
         if not state.recognition_started:
             state.recognition_started = True
         self._mark_stream_ready(state, payload, recognition_started=True)
 
     def _mark_stream_ready(
         self,
         state: _StreamState,
         payload: Mapping[str, Any],
         *,
         recognition_started: bool = False,
     ) -> None:
         if state.ready_event.is_set():
             return
 
         message_type_raw = None
         if isinstance(payload, Mapping):
             message_type_raw = payload.get("type") or payload.get("message")
         message_type = str(message_type_raw).lower() if message_type_raw else ""
 
         if message_type in {"error", "error_message"}:
             code = payload.get("code") or payload.get("error_code") or "error"
             reason = payload.get("reason") or payload.get("message") or ""
             state.ready_error = str(code)
             state.ready_error_detail = str(reason)
             state.ready_event.set()
