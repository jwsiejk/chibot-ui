 _TEST_RUNS: Dict[str, Dict[str, Any]] = {}
 _LOCK = threading.Lock()
 
 def _log(run_id: str, kind: str, msg: str, **extra: Any) -> None:
     rec = {"ts": time.time(), "kind": kind, "msg": msg}
     if extra:
         rec.update(extra)
     with _LOCK:
         logs = _TEST_RUNS[run_id]["logs"]
         rec["step"] = len(logs) + 1
         # build default label if not supplied
         if 'label' not in rec:
             label = kind
             if 'route' in rec and rec['route']:
                 label += f" – {rec['route']}"
             rec['label'] = label
         logs.append(rec)
 
 def start_test(mode: str = "voice") -> str:
     """Start a test run. mode in {"voice","chat"}"""
     run_id = uuid.uuid4().hex[:10]
     with _LOCK:
         _TEST_RUNS[run_id] = {
             "id": run_id,
             "mode": mode,
             "status": "running",
             "created_at": time.time(),
             "logs": [],
             "result": {},
         }
     t = threading.Thread(target=_run, args=(run_id, mode), daemon=True)
     t.start()
     return run_id
 
 def _run(run_id: str, mode: str) -> None:
