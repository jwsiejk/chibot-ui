-.chat{flex:1;overflow:auto;background:#0c1017;border:1px solid var(--border);border-radius:10px;padding:10px}
 .msg{padding:8px 10px;margin:6px;border-radius:10px;background:#11151c}
 .msg.user{background:#1d2330}
 .msg.assistant{background:#151c26}
 .dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-left:8px}
 .dot-ready{background:var(--muted)} .dot-listening{background:#39c07f} .dot-thinking{background:#f0ad4e} .dot-speaking{background:#7aa0ff}
 
 /* Composer stays inline */
-.composer{display:flex;gap:8px;align-items:center}
