 def _get_session_id(scope) -> str:
     try:
         raw = (scope.get("query_string") or b"").decode("utf-8", "ignore")
         if raw:
             for pair in raw.split("&"):
                 if not pair or "=" not in pair:
                     continue
                 k, v = pair.split("=", 1)
                 if k == "session_id":
                     return v or "default"
     except Exception:
         pass
     return "default"
 
 
