diff --git a/app/static/css/styles.css b/app/static/css/styles.css
index 32a4b418bc6208e708ed5665c29f80702f5de28d..5733dfa202d38f740f927a410bf05aea39a2a810 100644
--- a/app/static/css/styles.css
+++ b/app/static/css/styles.css
@@ -211,50 +211,53 @@ body{
 .chat{
   display:flex; flex-direction:column; gap:0;
   border:1px solid var(--border); border-radius:16px;
   background:linear-gradient(180deg, #0e1422, #0b101b);
   overflow:hidden;
 }
 .chat-header{
   padding:14px 16px; border-bottom:1px solid var(--border);
   background:rgba(255,255,255,.02);
 }
 .chat-header h2{margin:0; font-size:14px; letter-spacing:.3px; color:#b9c8e6}
 .messages{
   padding:16px; display:flex; flex-direction:column; gap:12px; overflow:auto; min-height:180px;
 }
 .msg{display:flex; flex-direction:column; gap:6px}
 .msg .bubble{
   max-width: 100%;
   background: var(--elev);
   border:1px solid var(--border);
   padding:12px 14px; border-radius:14px;
   box-shadow: 0 2px 10px rgba(0,0,0,.25) inset;
 }
 .msg.assistant .bubble{background:linear-gradient(180deg, #10192b, #0b1321)}
 .msg.user .bubble{background:linear-gradient(180deg, #101f2b, #0b1921)}
 .msg .meta{font-size:12px;color:var(--muted)}
+.msg.system .bubble{background:linear-gradient(180deg, #101c2d, #0c1423);border:1px solid rgba(92,130,194,0.35);color:#d7e6ff}
+.msg.system.chip-system .bubble{background:linear-gradient(180deg, #122a41, #0d1e31);border-color:rgba(120,166,255,0.45);box-shadow:0 6px 18px rgba(5,24,54,0.45)}
+.msg.system .meta{color:rgba(215,230,255,0.72)}
 
 /* Toolbar */
 .toolbar{
   position:sticky; bottom:0; z-index:10;
   display:grid; grid-template-columns:1fr auto 1fr; align-items:center;
   gap:12px; padding:12px 16px; border-top:1px solid var(--border);
   background: linear-gradient(180deg, rgba(8,12,20,.6), rgba(8,12,20,.9));
   backdrop-filter:saturate(140%) blur(6px);
 }
 .toolbar-center{display:flex; gap:10px; justify-content:center}
 .pill{
   display:inline-flex; align-items:center; gap:8px;
   border-radius:999px; padding:10px 16px;
   font-weight:700; letter-spacing:.3px; border:1px solid transparent;
   background:var(--glass); color:var(--text); cursor:pointer;
   transition: transform .04s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease;
   box-shadow: 0 6px 16px rgba(0,0,0,.25);
 }
 .pill:active{transform:translateY(1px)}
 .pill:focus-visible{
   outline:2px solid rgba(91,157,255,.8);
   outline-offset:3px;
 }
 .pill.start{background:linear-gradient(135deg, #1bd8a8, #1fbf7b); color:#04110c}
 .pill.end{background:linear-gradient(135deg, #ff6b81, #ff3b55); color:#190307}
