+
+  .timeline-shell {
+    padding: 18px 16px 64px;
+  }
+
+  .timeline-head,
+  .timeline-row,
+  .timeline-bookmark,
+  .timeline-empty,
+  .timeline-group-header {
+    grid-template-columns: 4px 80px 100px 80px minmax(120px, 1fr) minmax(160px, 1fr);
+  }
+
+  .timeline-head .type,
+  .timeline-row .type,
+  .timeline-group-header .type,
+  .timeline-bookmark .type {
+    display: none;
+  }
+}
