     def _emit_hub_log(self, label: str, detail: Mapping[str, Any]) -> None:
         payload = dict(detail)
         try:
             sanitized = telemetry_bus.redact_payload(payload)
         except Exception:
             sanitized = payload
         self._publish_event(
             EVT_CLIENT_LOG,
             {
                 "who": "server",
                 "meta": {
                     "label": label,
                     "detail": sanitized,
                 },
             },
         )
 
