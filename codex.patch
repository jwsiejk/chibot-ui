 async def _keepalive_task(websocket, heartbeat_ms: int):
     try:
         while True:
             await asyncio.sleep(max(heartbeat_ms, 1000) / 1000.0)
             try:
                 await websocket.send_text(dumps({
                     "type": "keepalive",
                     "ts": int(time.time() * 1000)
                 }))
             except Exception:
                 break
     except asyncio.CancelledError:
         pass
     except Exception:
