 def _resolve_origin_policy() -> "_OriginPolicy":
     raw = os.getenv("ASKCHIP_WS_ALLOWED_ORIGINS")
     if raw is not None:
         entries = tuple(filter(None, (_normalize_origin(item) for item in raw.split(","))))
         return _OriginPolicy(mode="explicit", values=entries)
 
