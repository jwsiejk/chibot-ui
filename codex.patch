       }
     } else if (frame.type === "tts.end") {
       const audioPlayer = getAudioPlayer();
       if (audioPlayer && typeof audioPlayer.handleTtsEnd === "function") {
         audioPlayer.handleTtsEnd(frame);
       }
+    } else if (frame.type === "asr.partial") {
