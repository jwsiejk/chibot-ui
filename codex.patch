     @staticmethod
     def _make_preview_from_bytes(payload: bytes, limit: int = 160) -> Optional[str]:
         if not payload:
             return None
         preview = payload.decode("utf-8", "replace")
         preview = preview.replace("\r", "\\r").replace("\n", "\\n")
         if len(preview) > limit:
             return f"{preview[: limit - 1]}…"
         return preview
 
