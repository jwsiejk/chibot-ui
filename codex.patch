+"""Browser-compatible authentication tests for chat.v2 adapter."""
+from __future__ import annotations
+
+import asyncio
+import json
+import unittest
+from typing import Any, Dict, Iterable, List, Tuple
+from unittest.mock import patch
+
+from app.telemetry import bus
+from app.ws.adapter import CHAT_V2_SUBPROTOCOL, ChatV2Adapter
+
+
+class TestBrowserWsAuthentication(unittest.TestCase):
+    """Verify query-string bearer handling for browser clients."""
+
+    def setUp(self) -> None:
+        bus.reset()
+
+    def tearDown(self) -> None:
+        bus.reset()
+
+    @staticmethod
+    def _make_scope(
+        *,
+        query_string: bytes | str = b"",
+        headers: Iterable[Tuple[bytes, bytes]] | None = None,
+    ) -> Dict[str, Any]:
+        return {
+            "type": "websocket",
+            "query_string": query_string,
+            "subprotocols": [CHAT_V2_SUBPROTOCOL],
+            "headers": list(headers or []),
+            "client": ("127.0.0.1", 4312),
+        }
+
+    async def _run_adapter(
+        self,
+        adapter: ChatV2Adapter,
+        events: List[dict],
+        *,
+        scope: Dict[str, Any],
+    ) -> List[dict]:
+        queue: asyncio.Queue[dict] = asyncio.Queue()
+        for event in events:
+            queue.put_nowait(event)
+
+        sent: List[dict] = []
+
+        async def receive() -> dict:
+            return await queue.get()
+
+        async def send(message: dict) -> None:
+            sent.append(message)
+
+        await adapter(scope, receive, send)
+        return sent
+
+    def _drive(
+        self,
+        adapter: ChatV2Adapter,
+        events: List[dict],
+        *,
+        scope: Dict[str, Any],
+    ) -> List[dict]:
+        return asyncio.run(self._run_adapter(adapter, events, scope=scope))
+
+    def test_extracts_token_from_query_string(self) -> None:
+        adapter = ChatV2Adapter()
+        token, error = adapter._extract_browser_token(
+            self._make_scope(query_string=b"access_token=my-token")
+        )
+
+        self.assertEqual(token, "my-token")
+        self.assertIsNone(error)
+
+    def test_query_token_sets_authorization_header(self) -> None:
+        adapter = ChatV2Adapter()
+        scope = self._make_scope(query_string=b"access_token=good-token")
+        events = [
+            {"type": "websocket.connect"},
+            {"type": "websocket.disconnect", "code": 1000},
+        ]
+
+        with patch("app.ws.adapter.authorize", return_value=(True, None)) as mock_authorize:
+            sent = self._drive(adapter, events, scope=scope)
+
+        self.assertTrue(any(msg.get("type") == "websocket.accept" for msg in sent))
+        mock_authorize.assert_called_once()
+        headers_arg = mock_authorize.call_args.args[0]
+        self.assertEqual(headers_arg.get("authorization"), "Bearer good-token")
+
+    def test_rejects_ambiguous_sources(self) -> None:
+        adapter = ChatV2Adapter()
+        scope = self._make_scope(
+            query_string=b"access_token=q-token",
+            headers=[(b"authorization", b"Bearer already")],
+        )
+        events = [{"type": "websocket.connect"}]
+
+        with patch("app.ws.adapter.authorize", return_value=(True, None)) as mock_authorize:
+            sent = self._drive(adapter, events, scope=scope)
+
+        mock_authorize.assert_not_called()
+        self.assertEqual(len(sent), 2)
+        start, body = sent
+        self.assertEqual(start["type"], "websocket.http.response.start")
+        self.assertEqual(start["status"], 401)
+        payload = json.loads(body["body"].decode("utf-8"))
+        self.assertEqual(
+            payload,
+            {"type": "error", "code": "unauthorized", "detail": "ambiguous auth"},
+        )
+
+    def test_invalid_token_is_rejected(self) -> None:
+        adapter = ChatV2Adapter()
+        scope = self._make_scope(query_string=b"access_token=bad-token")
+        events = [{"type": "websocket.connect"}]
+
+        with patch(
+            "app.ws.adapter.authorize", return_value=(False, "missing or invalid auth")
+        ):
+            sent = self._drive(adapter, events, scope=scope)
+
+        self.assertEqual(len(sent), 2)
+        start, body = sent
+        self.assertEqual(start["type"], "websocket.http.response.start")
+        self.assertEqual(start["status"], 401)
+        payload = json.loads(body["body"].decode("utf-8"))
+        self.assertEqual(
+            payload,
+            {"type": "error", "code": "unauthorized", "detail": "missing or invalid auth"},
+        )
+
+
+if __name__ == "__main__":  # pragma: no cover - convenience
+    unittest.main()