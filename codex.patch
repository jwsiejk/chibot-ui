+    monkeypatch.setattr(streaming, "get_provider", lambda cfg: Provider())
+    monkeypatch.setattr(streaming, "hygienic_suggestions", lambda text: [])
+    monkeypatch.setattr(streaming, "_collect_policy_chips", lambda policy: [])
+
