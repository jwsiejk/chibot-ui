 def _safe_url(url: str | None) -> str:
     if not url:
         return ""
     try:
         from urllib.parse import urlparse, urlunparse
 
         u = urlparse(url)
         # strip query to avoid leaking keys; keep scheme/host/path
         return urlunparse((u.scheme, u.netloc, u.path, "", "", ""))
