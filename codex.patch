             ctx.backpressure_state = "on"
             await self._publish(
                 EVT_BACKPRESSURE_ON,
                 ctx.sid,
                 {"queue_depth": queued, "state": "on"},
             )
         elif ctx.backpressure_state == "on" and queued < QUEUE_OFF_THRESHOLD:
             ctx.backpressure_state = "off"
