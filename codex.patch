+        "logging_level": coerce_logging_level(raw_logging, base["logging_level"]),
+    }
+
+
+def coerce_logging_level(
+    value: object, default: LoggingLevel = DEFAULT_LOGGING_LEVEL
+) -> LoggingLevel:
