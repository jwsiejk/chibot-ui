 def _parse_admin_cors_origins() -> tuple[str, ...]:
     raw = os.getenv("ASKCHIP_ADMIN_CORS_ORIGINS")
     if not raw:
         return ()
 
     entries = []
     for item in raw.split(","):
         value = item.strip()
         if value:
