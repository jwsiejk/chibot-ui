+        ):
+            normalized = [
+                action.strip()
+                for action in candidate_sequence
+                if isinstance(action, str) and action.strip()
+            ]
+            if normalized:
+                return normalized
+
+    if snapshot is None:
+        return list(_DEFAULT_ASSISTANT_TURN_ACTIONS)
