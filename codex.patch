 async function stopAdminCollector(page) {
   await page.evaluate(() => {
     const collector = window.__adminCollector;
     if (!collector) return;
     if (collector.source) {
       try { collector.source.close(); } catch {}
     }
     collector.stoppedAt = Date.now();
     collector.source = null;
   });
 }
 
