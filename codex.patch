 /* Buttons */
 button,.btn,input[type="button"],input[type="submit"]{
   background:#1f2837; color:var(--text);
   border:1px solid #2a3346; padding:6px 10px; border-radius:8px; cursor:pointer;
 }
 button.ghost{background:transparent;border-color:#2a3346}
 button.primary{background:#253149;border-color:#334260}
 button:disabled{opacity:.6;cursor:not-allowed}
 button:hover,.btn:hover,input[type="button"]:hover,input[type="submit"]:hover{border-color:var(--link)}
 button:focus-visible,.btn:focus-visible,input[type="button"]:focus-visible,input[type="submit"]:focus-visible{outline:2px solid var(--link); outline-offset:2px}
+.toolbar-buttons button{min-width:110px;font-size:15px}
+.toolbar-buttons #startButton.primary{background:var(--accent);border-color:var(--accent);color:#0b0d11;font-weight:700}
+.toolbar-buttons #endButton{background:#2f1c1c;border-color:#5a2b2b;color:#ffb5b5;font-weight:600}
+.toolbar-buttons #endButton:disabled{opacity:.5;color:var(--muted)}
 
 /* ---------------- Main screen forms (Sign in / Profile) ----------------
    Force tidy stacking by default; upgrade to 2 cols on desktop if forms exist. */
 
 /* Stack fields cleanly (but do NOT touch the chat composer above) */
 input[type="text"]:not(#chatInput):not([placeholder^="Type a message"]),
 input[type="email"],
 input[type="number"],
 input[type="password"],
 input[type="search"],
 textarea,
 select{
   display:block;
   width:min(420px,100%);
   background:#0f1115; color:var(--text);
   border:1px solid var(--border); border-radius:8px;
   padding:6px 8px; margin:0 0 12px;
 }
 label{display:block; font-size:13px; color:var(--muted); margin:6px 0 4px}
 
 /* Make ad-hoc rows wrap */
 form .row, .form .row{display:flex; flex-wrap:wrap; gap:12px 16px}
 
 /* Responsive 2-column grid if these forms exist */
 #profileForm, #signinForm{max-width:1080px}
 @media (min-width: 900px){
   #profileForm, #signinForm{
     display:grid; grid-template-columns: repeat(2, minmax(300px, 1fr)); gap:14px 24px;
   }
   #profileForm > label, #signinForm > label{margin-top:10px}
   #profileForm > label + input,
   #profileForm > label + select,
   #profileForm > label + textarea,
   #signinForm > label + input,
   #signinForm > label + select,
   #signinForm > label + textarea{width:100%}
   #profileForm .actions, #signinForm .actions{grid-column:1 / -1}
 }
 
