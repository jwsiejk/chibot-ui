+def _sanitize(messages: list[dict]) -> list[dict]:
+    sanitized: list[dict] = []
+    for item in messages:
+        if not isinstance(item, dict):
+            continue
+        sanitized.append(
+            {key: item[key] for key in item if key not in {"id", "req_id", "turn_id"}}
+        )
+    return sanitized
