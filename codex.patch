 def _dump_ndjson(events: Iterable[Dict[str, object]]) -> bytes:
     lines = [json.dumps(event, separators=(",", ":"), ensure_ascii=False) for event in events]
     if not lines:
         return b""
     return ("\n".join(lines) + "\n").encode("utf-8")
 
 
