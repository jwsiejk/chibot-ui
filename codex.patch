     async def wait_socket_open(self, timeout: float = 1.5) -> bool:
         """Micro-wait until the underlying websocket's .open flag is True."""
         if self._ws_is_open():
             return True
         end = time.time() + timeout
         while time.time() < end:
             if self._ws_is_open():
                 return True
             await asyncio.sleep(0.01)
         return False
 
