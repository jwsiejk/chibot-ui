         envelope = dict(event)
         sid = envelope.get("sid") or self._last_sid
         if not isinstance(sid, str) or not sid:
             return
         envelope.setdefault("sid", sid)
         envelope.setdefault("who", "server")
         envelope.setdefault("source", "voice_engine")
         self._publish(envelope)
 
