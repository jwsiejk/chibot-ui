 async def _drain_request_body(receive: Callable[[], Awaitable[dict]]) -> None:
     """Consume and discard the HTTP request body if present."""
     while True:
         message = await receive()
         if message.get("type") != "http.request":
             break
         if not message.get("more_body"):
             break
 
 
