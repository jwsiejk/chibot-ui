 const handleSpeechEnd = async (ctx, detail) => {
   if (ctx.state.manualGate) {
     return;
   }
   ctx.state.bargeConfirmActive = false;
   ctx.state.bargeConfirmUntil = 0;
   emitVoiceEvent('speech_end', detail);
