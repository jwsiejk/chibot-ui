 <script>
 (function(){
   async function loadFlow(){
     try{
       const r = await fetch('/api/v1/admin/config', {credentials:'include'});
       const j = await r.json();
       const s = j.settings || {};
       const $ = (id)=>document.getElementById(id);
 
       if ($('feature_audio')) $('feature_audio').checked = !!s.feature_audio;
       if ($('feature_manual_barge_in')) $('feature_manual_barge_in').checked = s.feature_manual_barge_in !== false;
       if ($('barge_in_mode_manual')) $('barge_in_mode_manual').checked = s.barge_in_mode_manual !== false;
+      if ($('auto_commit_when_ready')) $('auto_commit_when_ready').checked = s.auto_commit_when_ready !== false;
       if ($('confirm_ms')) $('confirm_ms').value = s.confirm_ms ?? 420;
       if ($('min_speech_ms')) $('min_speech_ms').value = s.min_speech_ms ?? 220;
       if ($('max_turn_seconds')) $('max_turn_seconds').value = s.max_turn_seconds ?? 90;
 
       if ($('tts_voice_id')) $('tts_voice_id').value = s.tts_voice_id || '';
       if ($('tts_output_format')) $('tts_output_format').value = s.tts_output_format || 'mp3_44100_128';
       if ($('tts_model_id')) $('tts_model_id').value = s.tts_model_id || 'eleven_multilingual_v2';
     }catch(e){ console.warn('[admin/flow] load error', e); }
   }
 
   async function saveFlow(){
     try{
       const $ = (id)=>document.getElementById(id);
       const payload = {
         feature_audio: !!($('feature_audio') && $('feature_audio').checked),
         feature_manual_barge_in: !!($('feature_manual_barge_in') && $('feature_manual_barge_in').checked),
         barge_in_mode_manual: !!($('barge_in_mode_manual') && $('barge_in_mode_manual').checked),
+        auto_commit_when_ready: !!($('auto_commit_when_ready') && $('auto_commit_when_ready').checked),
         confirm_ms: parseInt($('confirm_ms')?.value||'420',10),
         min_speech_ms: parseInt($('min_speech_ms')?.value||'220',10),
         max_turn_seconds: parseInt($('max_turn_seconds')?.value||'90',10),
         tts_voice_id: $('tts_voice_id')?.value || '',
         tts_output_format: $('tts_output_format')?.value || 'mp3_44100_128',
         tts_model_id: $('tts_model_id')?.value || 'eleven_multilingual_v2'
       };
       const r = await fetch('/api/v1/admin/config', {
         method:'POST',
         credentials:'include',
         headers:{'Content-Type':'application/json'},
         body: JSON.stringify(payload)
       });
       const j = await r.json();
       if (!j.ok) throw new Error('save failed');
       alert('Saved');
     }catch(e){ alert('Save failed'); console.warn('[admin/flow] save error', e); }
   }
 
   document.addEventListener('DOMContentLoaded', () => {
     loadFlow();
     const btn = document.getElementById('save-flow');
     if (btn) btn.addEventListener('click', saveFlow);
   });
 })();
