 async def ws_chat(websocket):
     """Accept, validate, send ready, then pump frames to keep the connection alive."""
     _jlog("ws_chat_compat_invoked")
     await websocket.accept()
     try:
         sid = _get_session_id(websocket.scope)
     except Exception:
         sid = "default"
 
