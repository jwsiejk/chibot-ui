 function drawIdleWave() {
   if (!ctx || !canvasWidth || !canvasHeight) return;
   clearCanvas();
   const midY = canvasHeight / 2;
   ctx.beginPath();
   ctx.moveTo(0, midY);
   ctx.lineTo(canvasWidth, midY);
   ctx.strokeStyle = 'rgba(120, 150, 220, 0.28)';
   ctx.lineWidth = 1.2;
   ctx.stroke();
 }
 
 function drawWaveform(values) {
