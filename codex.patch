+          try {
+            ctx.state.vadBoostDb = 0;
+          } catch {}
+        }, 250);
+      } catch {}
       startMaskLogging(ctx);
     } else if (normalizedState === 'ready') {
       ctx.state.ttsPlaying = false;
       ctx.ttsEndedAtMs = nowMs();
       ctx.ttsMask.clear();
       stopMaskLogging(ctx);
       logReadyState(ctx);
     }
   };
   try { win?.addEventListener?.('chip-tts', listener, { passive: true }); } catch {}
 };
 
