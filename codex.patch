+def _redirect_response(location: str) -> Response:
+    target = location.encode("utf-8", "ignore")
+    headers = (
+        (b"location", target),
+        (b"cache-control", b"no-store"),
+        (b"content-length", b"0"),
+    )
+    return Response(status=302, body=b"", headers=headers)
