 def _slugify_action_label(label: str) -> str:
     """Normalize a suggestion label into a stable slug identifier."""
 
     normalized = re.sub(r"[^a-z0-9]+", "-", label.strip().lower())
     slug = normalized.strip("-")
     return slug or "action"
 
 
