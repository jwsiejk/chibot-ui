     def on_audio(self, sid: str, chunk: bytes, seq: int) -> None:
         """Capture an incoming audio chunk."""
         session = self._ensure_session(sid)
         if session.tts_mask_phase != "off":
             self._publish_tts_mask(sid, "off")
