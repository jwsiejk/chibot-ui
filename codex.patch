+    }
+  }
+  if (!parsed.has("flow")) parsed.add("flow");
+  state.levels = parsed;
+  reflectLevelButtons();
+}
+
+function refreshSessions(opts = {}) {
+  const { force = false } = opts;
+  if (sessionsDebounce) {
+    clearTimeout(sessionsDebounce);
+    sessionsDebounce = null;
+  }
+  sessionsDebounce = setTimeout(async () => {
