 def silence_frame(meta: StreamMeta) -> bytes:
     expected = expected_pcm_frame_bytes(meta)
     if expected <= 0:
         return b""
     return b"\x00" * expected
 
 
 def is_probable_silence(frame: bytes) -> bool:
     if not frame:
         return True
     if len(frame) <= 2:
         return False
     first = frame[:1]
     return frame.count(first) == len(frame) and first in (b"\x00", b"\xff")
 
 
