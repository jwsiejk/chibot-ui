+    async def _test_multi_session_isolation(self) -> None:
+        engine = LabelRecordingEngine()
+        with patch.dict(os.environ, {"WS_PING_INTERVAL_MS": "0"}, clear=False):
+            adapter = ChatV2Adapter(engine=engine)
