 const median = (values) => {
   if (!Array.isArray(values) || values.length === 0) {
     return null;
   }
   const sorted = values.slice().sort((a, b) => a - b);
   const mid = Math.floor(sorted.length / 2);
   if (sorted.length % 2) {
     return sorted[mid];
   }
   if (mid === 0) {
     return sorted[0];
   }
   return (sorted[mid - 1] + sorted[mid]) / 2;
 };
 
