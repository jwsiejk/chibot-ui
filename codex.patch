+def _resolve_stream_open_timeout(default: float = 10.0) -> float:
+    raw = os.getenv("DG_STREAM_OPEN_TIMEOUT_S")
+    if raw is None:
+        return default
+    try:
+        timeout = float(raw)
+    except (TypeError, ValueError):
+        return default
+    if timeout <= 0:
+        return default
+    return timeout
+
