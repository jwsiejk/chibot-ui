 def _short_greeting(text: str) -> str:
     try:
         words = (text or "Hi there!").strip().split()
         if len(words) > 5:
             return " ".join(words[:5]).rstrip(",.;:!")
         return (text or "").strip()
     except Exception:
         return text
 
 
