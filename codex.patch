     @staticmethod
     def _coerce_payload(raw: Any) -> Optional[Dict[str, Any]]:
         if isinstance(raw, dict):
             return raw
         if isinstance(raw, str):
             try:
                 decoded = json.loads(raw)
             except json.JSONDecodeError:
                 return None
             if isinstance(decoded, dict):
                 return decoded
         return None
 
