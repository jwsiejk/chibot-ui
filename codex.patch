     except Exception:
         ts_ms_int = _now_ms()
     data["ts_ms"] = ts_ms_int
     data.setdefault("ts", ts_ms_int / 1000.0)
 
     sid = _normalize_session_id(data.pop("session_id", None) or data.get("sid"))
     if sid is not None:
         data["session_id"] = sid
         data["sid"] = sid
     else:
         data.pop("sid", None)
 
