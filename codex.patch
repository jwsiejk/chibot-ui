diff --git a/app/static/css/styles.css b/app/static/css/styles.css
index 78902dad2b484b8c3d3839fe29acb6852e5dc7f8..c7dba9f4789f27d63dc7d39e4e7971257c75ca75 100644
--- a/app/static/css/styles.css
