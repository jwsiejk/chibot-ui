 def _client_ip_from_scope(scope) -> str:
     try:
         c = scope.get("client") or ()
         if isinstance(c, (list, tuple)) and c:
             return str(c[0])
     except Exception:
         pass
     try:
         hdrs = {k.decode().lower(): v.decode() for k, v in (scope.get("headers") or [])}
         xff = hdrs.get("x-forwarded-for", "").split(",")[0].strip()
         if xff:
             return xff
     except Exception:
         pass
     return "unknown"
 
 
