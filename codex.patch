+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Ask Chip — Flow Inspector</title>
+  <link rel="icon" href="/static/favicon.ico" type="image/x-icon">
+  <link rel="stylesheet" href="/static/css/app.css">
+  <link rel="stylesheet" href="/static/css/admin_flow.css">
+</head>
+<body>
+  <div id="admin-flow-app" class="flow-app" data-route="flow">
+    <header class="flow-header">
+      <div class="flow-header-main">
+        <div class="session-picker" data-ref="session-picker">
+          <label for="flowSessionInput">Session</label>
+          <div class="session-input">
+            <input id="flowSessionInput" type="search" placeholder="Search active sessions" autocomplete="off">
+            <datalist id="flowSessionOptions"></datalist>
+            <button type="button" id="flowSessionRefresh" class="icon-btn" title="Refresh sessions" aria-label="Refresh sessions">
+              <span>↻</span>
+            </button>
+          </div>
+          <div class="session-hint" id="flowSessionHint">Select a session to start.</div>
+          <ul class="session-results" id="flowSessionResults" role="listbox" aria-label="Active sessions"></ul>
+        </div>
+        <div class="level-toggles" data-ref="level-toggles">
+          <span class="group-label">Levels</span>
+          <div class="toggle-group">
+            <button type="button" class="toggle active" data-level="flow" disabled>Flow</button>
+            <button type="button" class="toggle active" data-level="transition">Transitions</button>
+            <button type="button" class="toggle" data-level="debug">Debug</button>
+            <button type="button" class="toggle" data-level="raw">Raw</button>
+          </div>
+        </div>
+        <div class="grouping" data-ref="grouping">
+          <span class="group-label">Grouping</span>
+          <div class="toggle-group">
+            <button type="button" class="toggle" data-group="phase">By Phase</button>
+            <button type="button" class="toggle" data-group="turn">By Turn</button>
+            <button type="button" class="toggle active" data-group="chronological">Chronological</button>
+          </div>
+        </div>
+      </div>
+      <div class="flow-header-secondary">
+        <div class="filters" data-ref="filters">
+          <label class="filter-search">
+            <span>Filter</span>
+            <input id="flowFilterInput" type="search" placeholder="type, who, phase…" autocomplete="off">
+          </label>
+          <label class="filter-turn">
+            <span>Turn</span>
+            <input id="flowTurnInput" type="number" min="0" step="1" placeholder="Any">
+          </label>
+          <div class="filter-chips" id="flowFilterChips" aria-live="polite"></div>
+        </div>
+        <div class="tail" data-ref="tail">
+          <div class="tail-state" id="flowTailState" role="status">Paused</div>
+          <div class="tail-actions">
+            <button type="button" id="flowTailToggle" class="toggle">Go live</button>
+            <button type="button" id="flowTailStep" class="toggle" title="Fetch latest once">Refresh</button>
+          </div>
+        </div>
+        <div class="flow-actions" data-ref="actions">
+          <button type="button" id="flowExportFull" class="action-btn">Export NDJSON</button>
+          <button type="button" id="flowExportRedacted" class="action-btn">Export Redacted</button>
+          <button type="button" id="flowCopyLink" class="action-btn">Copy link</button>
+          <button type="button" id="flowHandoff" class="action-btn">Hand off to ChatGPT</button>
+        </div>
+      </div>
+    </header>
+
+    <main class="flow-main">
+      <div class="timeline-shell">
+        <div class="timeline-head">
+          <div class="timeline-col rail" aria-hidden="true"></div>
+          <div class="timeline-col time">Time (ms)</div>
+          <div class="timeline-col phase">Phase</div>
+          <div class="timeline-col who">Who</div>
+          <div class="timeline-col type">Type</div>
+          <div class="timeline-col blurb">Blurb</div>
+          <div class="timeline-col meta">Meta</div>
+        </div>
+        <div class="timeline-body" id="flowTimeline" role="treegrid" aria-live="polite"></div>
+      </div>
+      <aside class="flow-drawer" id="flowDrawer" aria-live="polite" aria-hidden="true">
+        <div class="drawer-header">
+          <h2 id="flowDrawerTitle">Event</h2>
+          <div class="drawer-actions">
+            <button type="button" id="flowDrawerCopy" class="icon-btn" title="Copy JSON">⧉</button>
+            <button type="button" id="flowDrawerClose" class="icon-btn" title="Close">✕</button>
+          </div>
+        </div>
+        <div class="drawer-meta" id="flowDrawerMeta"></div>
+        <div class="drawer-related" id="flowDrawerRelated"></div>
+        <pre class="drawer-json" id="flowDrawerJson"></pre>
+      </aside>
+    </main>
+  </div>
+
+  <script type="module" src="/static/js/admin_flow.js"></script>
+</body>
+</html>
