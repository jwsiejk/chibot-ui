@@ -537,50 +537,87 @@ body{
   border:1px solid var(--border);
   border-radius:18px;
   padding:18px 20px;
   box-shadow:var(--shadow);
 }
 .admin-logs__filters{align-items:flex-start;gap:20px;}
 .admin-logs__field{
   flex:1 1 240px;
   min-width:220px;
   display:flex;
   flex-direction:column;
   gap:6px;
 }
 .admin-logs__field label{
   font-size:11px;
   letter-spacing:.4px;
   text-transform:uppercase;
   color:var(--muted);
 }
 .admin-logs__actions{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
 .admin-logs__filter-header{
   display:flex;
   align-items:center;
   gap:12px;
 }
+.admin-logs__presets{
+  display:flex;
+  flex-wrap:wrap;
+  gap:8px;
+  margin:0;
+  padding:0;
+  list-style:none;
+}
+.admin-logs__presets[hidden]{
+  display:none;
+}
+.admin-logs__preset{
+  border:1px solid var(--border);
+  background:rgba(255,255,255,.04);
+  border-radius:999px;
+  padding:4px 10px;
+  font-size:11px;
+  letter-spacing:.25px;
+  text-transform:uppercase;
+  color:var(--muted);
+  cursor:pointer;
+  transition:background .2s ease,border-color .2s ease,color .2s ease;
+}
+.admin-logs__preset:hover{
+  border-color:rgba(91,157,255,.25);
+  color:var(--text);
+}
+.admin-logs__preset:focus-visible{
+  outline:2px solid rgba(91,157,255,.65);
+  outline-offset:2px;
+  border-color:rgba(91,157,255,.4);
+}
+.admin-logs__preset.is-active{
+  background:rgba(91,157,255,.18);
+  border-color:rgba(91,157,255,.45);
+  color:var(--text);
+}
 .admin-logs__filter-header h2{
   margin:0;
   font-size:13px;
   letter-spacing:.35px;
   text-transform:uppercase;
   color:var(--muted);
 }
 .admin-logs__types{
   display:flex;
   flex-wrap:wrap;
   gap:12px;
 }
 .admin-logs__type{
   display:inline-flex;
   align-items:center;
   gap:6px;
   padding:6px 12px;
   border-radius:999px;
   border:1px solid var(--border);
   background:rgba(255,255,255,.04);
   font-size:12px;
   letter-spacing:.25px;
   color:var(--muted);
 }
 .admin-logs__type span{color:var(--text);font-weight:600;letter-spacing:.2px;text-transform:none;}
