 def _normalize_origin(value: str) -> Optional[str]:
     raw = value.strip()
     if not raw:
         return None
 
     parsed = urlparse(raw)
     if parsed.scheme and parsed.netloc:
         scheme = parsed.scheme.lower()
         netloc = parsed.netloc.lower()
         return f"{scheme}://{netloc}"
 
     lowered = raw.lower()
     if lowered == "*":
         return None
     return lowered
 
 
