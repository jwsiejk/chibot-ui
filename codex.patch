diff --git a/app/static/css/styles.css b/app/static/css/styles.css
index 55ff35254d3c2d98fd26f70e7a2b2c8212ddd8d3..cf3197bfb9b125ec7c53e31937bccc657f59abc3 100644
--- a/app/static/css/styles.css
+++ b/app/static/css/styles.css
@@ -103,50 +103,92 @@ body{
 }
 .chip-window{
   position:relative;
   width:min(1200px, 100%); aspect-ratio:16/9;
   border-radius:20px;
   background:linear-gradient(180deg, #0E1627 0%, #0A0F1B 100%);
   box-shadow:var(--shadow);
   overflow:hidden;
   border:1px solid var(--border);
 }
 .wave-canvas{
   position:absolute; inset:0; width:100%; height:100%;
   filter: contrast(1.15) saturate(1.2);
 }
 .chip-overlay{
   position:absolute; inset:0; display:flex; flex-direction:column;
   justify-content:space-between; pointer-events:none; padding:16px;
 }
 .chip-status{
   align-self:flex-start; display:flex; align-items:center; gap:8px;
   padding:8px 12px; border-radius:999px;
   background:rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.22);
   backdrop-filter: blur(6px);
   font-weight:600; letter-spacing:.2px;
 }
+.mode-suggestions{
+  align-self:center;
+  display:flex;
+  flex-direction:column;
+  gap:10px;
+  padding:14px 18px;
+  border-radius:18px;
+  background:rgba(8,12,20,.55);
+  border:1px solid rgba(255,255,255,.18);
+  box-shadow:0 18px 36px rgba(0,0,0,.45);
+  backdrop-filter:blur(12px);
+  color:var(--text);
+  text-align:center;
+  max-width:min(80%, 520px);
+  margin:0 auto;
+}
+.mode-suggestions.hidden{display:none}
+.mode-suggestions__label{
+  font-size:11px;
+  letter-spacing:.35px;
+  text-transform:uppercase;
+  color:var(--muted);
+}
+.mode-suggestions__chips{
+  display:flex;
+  flex-wrap:wrap;
+  gap:12px;
+  justify-content:center;
+}
+.mode-chip{
+  display:inline-flex;
+  align-items:center;
+  justify-content:center;
+  padding:8px 16px;
+  border-radius:999px;
+  background:linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.16));
+  border:1px solid rgba(255,255,255,.18);
+  color:var(--text);
+  font-weight:600;
+  letter-spacing:.25px;
+  box-shadow:0 10px 22px rgba(0,0,0,.35);
+}
 .status-dot{width:8px;height:8px;border-radius:50%;background:#999; display:inline-block}
 .status-dot.on{background:var(--success)}
 .voice-chip{
   align-self:flex-end; display:flex; gap:8px; align-items:center;
   padding:8px 14px; border-radius:999px;
   background:rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.22);
   backdrop-filter: blur(6px);
   color:var(--text); font-weight:600;
 }
 .sep{opacity:.5}
 .chip-label{
   font-size:12px;
   text-transform:uppercase;
   letter-spacing:.4px;
   color:var(--muted);
 }
 
 /* Chat */
 .chat{
   display:flex; flex-direction:column; gap:0;
   border:1px solid var(--border); border-radius:16px;
   background:linear-gradient(180deg, #0e1422, #0b101b);
   overflow:hidden;
 }
 .chat-header{
