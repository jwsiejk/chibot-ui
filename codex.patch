 def _clip_text(txt: str, limit: int = 120) -> str:
     try:
         txt = txt or ""
         if len(txt) <= limit:
             return txt
         return txt[:limit] + "…"
     except Exception:
         return ""
 
 
 def _dumps(obj) -> str:
