 async def _read_body(receive) -> bytes:
     chunks: list[bytes] = []
     while True:
         message = await receive()
         if message.get("type") != "http.request":
             break
         body = message.get("body", b"") or b""
         if body:
             chunks.append(body)
         if not message.get("more_body", False):
             break
     return b"".join(chunks)
 
 
