 import asyncio
 import json
+from collections import deque
 
 from app.ws import ws_asgi
 
 
 def _json_payloads(messages):
     out = []
     for msg in messages:
         if msg.get("type") != "websocket.send":
             continue
         text = msg.get("text")
         if not text:
             continue
         try:
             out.append(json.loads(text))
         except Exception:
             continue
     return out
 
 
