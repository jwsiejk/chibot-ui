     @staticmethod
     def _normalize_greet_reply(candidate: Any) -> str:
         if not isinstance(candidate, str):
             return ""
         normalized = " ".join(candidate.strip().split())
         if not normalized:
             return ""
         words = normalized.split()
         if len(words) > 8:
             normalized = " ".join(words[:8])
         return normalized
 
