 def env_bool(name: str, default: bool = False) -> bool:
     """Return an environment variable parsed as a boolean."""
 
     value = os.getenv(name)
     if value is None:
         return bool(default)
     value = value.strip().lower()
     if value in {"1", "true", "t", "yes", "y", "on"}:
         return True
     if value in {"0", "false", "f", "no", "n", "off"}:
         return False
     return bool(default)
 
