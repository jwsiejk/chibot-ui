 def _get(d: Mapping[str, Any], path: Sequence[str], default: Any = None) -> Any:
     cur: Any = d
     for key in path:
         if not isinstance(cur, Mapping) or key not in cur:
             return default
         cur = cur[key]
     return cur
 
