+  hooks.stopRecorder({ reason: 'test_cleanup' });
+  if (typeof recorder.onstop === 'function') {
+    await recorder.onstop();
+  }
+
+  if (hooks.state.turnTimer) {
+    clearTimeout(hooks.state.turnTimer);
