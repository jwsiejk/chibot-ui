     @staticmethod
     def _decode_headers(headers: Iterable[tuple[bytes, bytes]]) -> Dict[str, str]:
         decoded: Dict[str, str] = {}
         for key, value in headers:
             decoded[key.decode("latin1").lower()] = value.decode("latin1")
         return decoded
 
     @staticmethod
     def _now_ms() -> int:
